{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_AZURE_CONNECTION_STRING"
  },
  "JWT": {
    "ServerKey": "Server_Security_Key",
    "Issuer": "Your_Issuer",
    "Audience": "Your_Audience",
    "AccessTokenMinutes": 0,
    "RefreshTokenDays": 0
  }
}